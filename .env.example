# Copy this file to .env and fill in your key. The .env file is gitignored.

# Key for the assistant feature.
AI_API_KEY=

# Optional. Defaults below work with OpenAI.
# For a free tier you can point these at Google Gemini's OpenAI-compatible endpoint:
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-2.0-flash
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
